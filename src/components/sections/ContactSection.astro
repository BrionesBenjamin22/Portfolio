---
import SectionHeader from "../ui/SectionHeader.astro";

const contactMethods = [
  {
    label: "Email",
    value: "benja.briones004@gmail.com",
    href: "mailto:benja.briones004@gmail.com",
    icon: "mail",
  },
  {
    label: "Teléfono",
    labelEn: "Phone",
    value: "+54 9 221 6691441",
    href: "tel:+5492216691441",
    icon: "phone",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/benjamín-briones-784375326",
    href: "https://www.linkedin.com/in/benjam%C3%ADn-briones-784375326/",
    icon: "linkedin",
  },
  {
    label: "GitHub",
    value: "github.com/BrionesBenjamin22",
    href: "https://github.com/BrionesBenjamin22",
    icon: "github",
  },
];
---

<section id="contacto" class="mt-20 space-y-8">
  <SectionHeader
    eyebrow="Contacto"
    eyebrowEn="Contact"
    title="Hablemos"
    titleEn="Let's talk"
    description="Canales para conocer mi trabajo o ponernos en contacto."
    descriptionEn="Channels to learn about my work or get in touch."
    maxWidth="max-w-2xl"
  />

  <div class="grid gap-4 sm:grid-cols-2">
    {contactMethods.map((method) => (
      <a
        href={method.href}
        target={method.href.startsWith("http") ? "_blank" : undefined}
        rel={method.href.startsWith("http") ? "noreferrer" : undefined}
        class="group flex items-center gap-4 rounded-2xl border border-slate-800 bg-slate-900/60 p-5 transition-all duration-200 hover:-translate-y-1 hover:border-slate-600"
      >
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-slate-700 bg-slate-950 text-slate-300 transition-colors group-hover:text-white">
          {method.icon === "mail" && (
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
          )}
          {method.icon === "phone" && (
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.62 2.61a2 2 0 0 1-.45 2.11L8.01 9.71a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.84.29 1.71.5 2.61.62A2 2 0 0 1 22 16.92Z" /></svg>
          )}
          {method.icon === "linkedin" && (
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V9h4v2a6 6 0 0 1 5-3Z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg>
          )}
          {method.icon === "github" && (
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
          )}
        </span>
        <span class="min-w-0">
          <span class="block text-sm font-medium text-slate-200" data-lang-es={method.label} data-lang-en={method.labelEn ?? method.label}>{method.label}</span>
          <span class="mt-1 block break-all text-sm text-slate-400 transition-colors group-hover:text-slate-200">{method.value}</span>
        </span>
      </a>
    ))}
  </div>
</section>
