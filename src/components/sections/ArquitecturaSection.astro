---
import SectionHeader from "../ui/SectionHeader.astro";
import InfoCard from "../ui/InfoCard.astro";

interface Layer {
  step: string;
  name: string;
  description: string;
}

interface Architecture {
  title: string;
  description: string;
  layers: Layer[];
  flow: string;
}

interface Project {
  architecture: Architecture | null;
}

const { project } = Astro.props as { project: Project };
---

{project?.architecture && (
  <section class="mt-20 space-y-8">
    <SectionHeader
      eyebrow="Arquitectura"
      title={project.architecture.title}
      description={project.architecture.description}
    />

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {project.architecture.layers.map((layer) => (
        <InfoCard>
          <p class="text-sm uppercase tracking-[0.2em] text-slate-500">
            {layer.step}
          </p>

          <h3 class="mt-3 text-lg font-semibold text-slate-100">
            {layer.name}
          </h3>

          <p class="mt-2 text-sm leading-6 text-slate-400">
            {layer.description}
          </p>
        </InfoCard>
      ))}
    </div>

    <InfoCard className="p-6">
      <h3 class="text-lg font-semibold text-slate-100">
        Flujo de arquitectura
      </h3>

      <p class="mt-4 text-slate-400 leading-7">
        {project.architecture.flow}
      </p>

      <p class="mt-2 text-sm text-slate-500">
        Esta estructura organiza el proyecto en bloques claros y facilita la
        mantenibilidad, la escalabilidad y la consistencia entre sus partes.
      </p>
    </InfoCard>
  </section>
)}