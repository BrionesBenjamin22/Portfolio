---
import SectionHeader from "../ui/SectionHeader.astro";
import InfoCard from "../ui/InfoCard.astro";
---

<section id="carrera" class="mt-20 space-y-8">
  <SectionHeader
    eyebrow="Carrera académica"
    eyebrowEn="Education"
    title="Ingeniería en Sistemas de Información"
    titleEn="Information Systems Engineering"
    description="Formación universitaria orientada al análisis, diseño y desarrollo de sistemas de información."
    descriptionEn="University education focused on the analysis, design and development of information systems."
    maxWidth="max-w-3xl"
  />

  <InfoCard className="p-6 md:p-8">
    <p
      class="text-sm uppercase tracking-[0.2em] text-slate-500"
      data-lang-es="Institución"
      data-lang-en="Institution"
    >Institución</p>
    <h3
      class="mt-3 text-2xl font-semibold text-slate-100"
      data-lang-es="Universidad Tecnológica Nacional - Facultad Regional La Plata"
      data-lang-en="National Technological University - La Plata Regional Faculty"
    >Universidad Tecnológica Nacional - Facultad Regional La Plata</h3>
    <p
      class="mt-4 text-slate-400"
      data-lang-es="Período: 2022 - Presente"
      data-lang-en="Period: 2022 - Present"
    >Período: 2022 - Presente</p>
  </InfoCard>
</section>
