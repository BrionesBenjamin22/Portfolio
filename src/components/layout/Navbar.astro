---
const pathname = Astro.url.pathname;
---

<header class="border-b border-slate-800">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="font-semibold text-lg text-slate-100 hover:text-white transition-colors">
      Benjamín Briones
    </a>

    <nav class="flex items-center gap-6 text-sm">
      <a
        href="/"
        class:list={[
          "transition-colors hover:text-white",
          pathname === "/" ? "text-white" : "text-slate-400"
        ]}
      >
        Inicio
      </a>

      <a
        href="/#proyectos"
        class="text-slate-400 transition-colors hover:text-white"
      >
        Proyectos
      </a>

      <a
        href="/contacto"
        class:list={[
          "transition-colors hover:text-white",
          pathname === "/contacto" ? "text-white" : "text-slate-400"
        ]}
      >
        Contacto
      </a>

        <a
        href="https://github.com/BrionesBenjamin22"
        target="_blank"
        rel="noreferrer"
        class="rounded-lg border border-slate-700 px-3 py-1.5 text-sm text-slate-300 transition-colors hover:border-slate-500 hover:text-white"
        >
        GitHub
        </a>
    </nav>
  </div>
</header>