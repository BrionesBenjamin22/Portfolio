---
const pathname = Astro.url.pathname;
---

<header class="border-b border-slate-800">
  <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <a href="/" class="font-semibold text-lg text-slate-100 hover:text-white transition-colors">
      Portfolio
    </a>

    <nav class="flex flex-wrap items-center justify-center gap-4 text-sm md:gap-6">
      <a
        href="/"
        class:list={[
          "transition-colors hover:text-white",
          pathname === "/" ? "text-white" : "text-slate-400"
        ]}
        data-lang-es="Inicio"
        data-lang-en="Home"
      >
        Inicio
      </a>

      <a
        href="/#proyectos"
        class="text-slate-400 transition-colors hover:text-white"
        data-lang-es="Proyectos"
        data-lang-en="Projects"
      >
        Proyectos
      </a>

      <a
        href="/#carrera"
        class="text-slate-400 transition-colors hover:text-white"
        data-lang-es="Carrera"
        data-lang-en="Education"
      >
        Carrera
      </a>

      <a
        href="/#curriculum"
        class="text-slate-400 transition-colors hover:text-white"
        data-lang-es="Curriculum"
        data-lang-en="Resume"
      >
        Curriculum
      </a>

      <a
        href="/#contacto"
        class="text-slate-400 transition-colors hover:text-white"
        data-lang-es="Contacto"
        data-lang-en="Contact"
      >
        Contacto
      </a>

        <button
        type="button"
        id="language-toggle"
        class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900/60 px-2 py-1 text-xs font-medium text-slate-300 transition-colors hover:border-slate-500 hover:text-white"
        aria-label="Cambiar idioma"
        aria-pressed="false"
        >
        <span data-lang-option="es" class="rounded-full bg-slate-700 px-2 py-0.5 text-white transition-colors">ES</span>
        <span data-lang-option="en" class="rounded-full px-2 py-0.5 text-slate-500 transition-colors">EN</span>
        </button>

        <a
        href="https://github.com/BrionesBenjamin22"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-slate-700 px-3 py-1.5 text-sm text-slate-300 transition-colors hover:border-slate-500 hover:text-white"
        >
        <svg
          aria-hidden="true"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
        GitHub
        </a>
    </nav>
  </div>
</header>

<script>
  const navLinks = document.querySelectorAll('a[href="/"], a[href^="/#"]');

  navLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const anchor = event.currentTarget;
      if (!(anchor instanceof HTMLAnchorElement)) return;

      const targetUrl = new URL(anchor.href);
      if (targetUrl.pathname !== window.location.pathname) return;

      event.preventDefault();

      if (!targetUrl.hash) {
        window.scrollTo({ top: 0, behavior: "smooth" });
        history.pushState(null, "", targetUrl.pathname);
        return;
      }

      const target = document.querySelector(targetUrl.hash);
      if (!target) return;

      target.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
      history.pushState(null, "", targetUrl.hash);
    });
  });

  const languageToggle = document.getElementById("language-toggle");
  const languageOptions = document.querySelectorAll("[data-lang-option]");

  const applyLanguage = (language) => {
    const safeLanguage = language === "en" ? "en" : "es";
    document.documentElement.lang = safeLanguage;

    document.querySelectorAll("[data-lang-es][data-lang-en]").forEach((element) => {
      const nextText = element.getAttribute(`data-lang-${safeLanguage}`);
      if (nextText !== null) {
        element.textContent = nextText;
      }
    });

    document.querySelectorAll("[data-href-es][data-href-en]").forEach((element) => {
      const nextHref = element.getAttribute(`data-href-${safeLanguage}`);
      if (nextHref !== null && element instanceof HTMLAnchorElement) {
        element.href = nextHref;
      }
    });

    languageOptions.forEach((option) => {
      const isActive = option.getAttribute("data-lang-option") === safeLanguage;
      option.classList.add("rounded-full");
      option.classList.toggle("bg-slate-700", isActive);
      option.classList.toggle("text-white", isActive);
      option.classList.toggle("text-slate-500", !isActive);
    });

    languageToggle?.setAttribute("aria-pressed", String(safeLanguage === "en"));
    window.localStorage.setItem("portfolio-language", safeLanguage);
    window.dispatchEvent(new CustomEvent("portfolio-language-change", {
      detail: { language: safeLanguage },
    }));
  };

  const initialLanguage = window.localStorage.getItem("portfolio-language") === "en" ? "en" : "es";
  applyLanguage(initialLanguage);

  languageToggle?.addEventListener("click", () => {
    const currentLanguage = window.localStorage.getItem("portfolio-language") === "en" ? "en" : "es";
    applyLanguage(currentLanguage === "en" ? "es" : "en");
  });
</script>
