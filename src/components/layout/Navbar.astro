---
const pathname = Astro.url.pathname;

const links = [
  { href: "/sobre-mi", label: "Sobre mí", labelEn: "About" },
  { href: "/#stack", label: "Stack", labelEn: "Stack" },
  { href: "/proyectos", label: "Proyectos", labelEn: "Projects" },
];
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-4 md:flex-row md:items-center md:justify-between">
    <a href="/" class="focus-ring text-base font-semibold tracking-tight" data-lang-es="Benjamín Briones" data-lang-en="Benjamín Briones">
      Benjamín Briones
    </a>

    <nav class="flex flex-wrap items-center gap-4 text-sm md:gap-5" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "focus-ring link-quiet",
            pathname === link.href ? "font-medium" : "",
          ]}
          data-lang-es={link.label}
          data-lang-en={link.labelEn}
        >
          {link.label}
        </a>
      ))}

      <button
        type="button"
        id="language-toggle"
        class="focus-ring link-quiet rounded-full border border-line px-3 py-1 text-xs"
        aria-label="Cambiar idioma"
        aria-pressed="false"
      >
        <span data-lang-current>ES</span>
      </button>

      <button
        type="button"
        id="theme-toggle"
        class="focus-ring link-quiet rounded-full border border-line px-3 py-1 text-xs"
        aria-label="Cambiar tema"
        data-lang-es="Tema"
        data-lang-en="Theme"
      >
        Tema
      </button>
    </nav>
  </div>
</header>

<script>
  const navLinks = document.querySelectorAll('a[href="/"], a[href^="/#"]');

  navLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const anchor = event.currentTarget;
      if (!(anchor instanceof HTMLAnchorElement)) return;

      const targetUrl = new URL(anchor.href);
      if (targetUrl.pathname !== window.location.pathname) return;

      event.preventDefault();

      if (!targetUrl.hash) {
        window.scrollTo({ top: 0, behavior: "smooth" });
        history.pushState(null, "", targetUrl.pathname);
        return;
      }

      const target = document.querySelector(targetUrl.hash);
      if (!target) return;

      target.scrollIntoView({ behavior: "smooth", block: "start" });
      history.pushState(null, "", targetUrl.hash);
    });
  });

  const languageToggle = document.getElementById("language-toggle");
  const languageCurrent = document.querySelector("[data-lang-current]");

  const applyLanguage = (language) => {
    const safeLanguage = language === "en" ? "en" : "es";
    document.documentElement.lang = safeLanguage;

    document.querySelectorAll("[data-lang-es][data-lang-en]").forEach((element) => {
      const nextText = element.getAttribute(`data-lang-${safeLanguage}`);
      if (nextText !== null) {
        element.textContent = nextText;
      }
    });

    document.querySelectorAll("[data-href-es][data-href-en]").forEach((element) => {
      const nextHref = element.getAttribute(`data-href-${safeLanguage}`);
      if (nextHref !== null && element instanceof HTMLAnchorElement) {
        element.href = nextHref;
      }
    });

    if (languageCurrent) {
      languageCurrent.textContent = safeLanguage.toUpperCase();
    }

    languageToggle?.setAttribute("aria-pressed", String(safeLanguage === "en"));
    window.localStorage.setItem("portfolio-language", safeLanguage);
    window.dispatchEvent(new CustomEvent("portfolio-language-change", {
      detail: { language: safeLanguage },
    }));
  };

  const applyTheme = (theme) => {
    const safeTheme = theme === "dark" ? "dark" : "light";
    document.documentElement.classList.toggle("dark", safeTheme === "dark");
    window.localStorage.setItem("portfolio-theme", safeTheme);
  };

  const initialLanguage = window.localStorage.getItem("portfolio-language") === "en" ? "en" : "es";
  applyLanguage(initialLanguage);

  languageToggle?.addEventListener("click", () => {
    const currentLanguage = window.localStorage.getItem("portfolio-language") === "en" ? "en" : "es";
    applyLanguage(currentLanguage === "en" ? "es" : "en");
  });

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const currentTheme = document.documentElement.classList.contains("dark") ? "dark" : "light";
    applyTheme(currentTheme === "dark" ? "light" : "dark");
  });
</script>
