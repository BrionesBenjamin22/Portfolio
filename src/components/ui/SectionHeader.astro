---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  maxWidth?: string;
}

const {
  eyebrow,
  title,
  description,
  maxWidth = "max-w-3xl"
} = Astro.props;
---

<div class:list={[maxWidth, "space-y-4"]}>
  <span class="text-sm uppercase tracking-[0.2em] text-slate-500">
    {eyebrow}
  </span>

  <h2 class="text-3xl md:text-4xl font-bold text-slate-100">
    {title}
  </h2>

  <p class="text-slate-400 text-base md:text-lg leading-7">
    {description}
  </p>
</div>