---
interface Props {
  value: string;
  title: string;
  description: string;
  className?: string;
}

const { value, title, description, className } = Astro.props;
---

<article
  class:list={[
    "rounded-2xl border border-slate-800 bg-slate-900/60 p-5 transition-all duration-200 hover:-translate-y-1 hover:border-slate-700",
    className
  ]}
>
  <p class="text-3xl font-bold text-slate-100">{value}</p>

  <h3 class="mt-3 text-base font-semibold text-slate-200">
    {title}
  </h3>

  <p class="mt-2 text-sm leading-6 text-slate-400">
    {description}
  </p>
</article>