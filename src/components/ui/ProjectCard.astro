---
import Badge from "./Badge.astro";

interface Props {
  id: string;
  title: string;
  titleEn?: string;
  description: string;
  descriptionEn?: string;
  status?: string;
  statusEn?: string;
  tags?: string[];
  tagsEn?: string[];
  featured?: boolean;
  index?: number;
}

const {
  id,
  title,
  titleEn = title,
  description,
  descriptionEn = description,
  status = "En desarrollo",
  statusEn = status,
  tags = [],
  tagsEn = tags,
  featured = false,
  index = 0,
} = Astro.props;
---

<article
  data-project-card={id}
  style={`--project-delay: ${index * 80}ms`}
  class:list={[
    "project-card group relative overflow-hidden rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1",
    featured
      ? "border-blue-500/30 bg-slate-900 shadow-[0_0_0_1px_rgba(59,130,246,0.10)] hover:border-blue-400/50"
      : "border-slate-800 bg-slate-900/60 hover:border-slate-600",
  ]}
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-slate-500/40 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

  <div class="flex h-full flex-col justify-between gap-5">
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        {featured ? (
          <Badge variant="featured" data-lang-es="Proyecto destacado" data-lang-en="Featured project">Proyecto destacado</Badge>
        ) : (
          <Badge variant="status" data-lang-es={status} data-lang-en={statusEn}>{status}</Badge>
        )}
      </div>

      <div class="space-y-3">
        <h3
          class="text-2xl font-semibold text-slate-100 transition-colors duration-300 group-hover:text-white"
          data-lang-es={title}
          data-lang-en={titleEn}
        >
          {title}
        </h3>

        <p
          class="text-slate-400 leading-7"
          data-lang-es={description}
          data-lang-en={descriptionEn}
        >
          {description}
        </p>
      </div>
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag, tagIndex) => (
          <Badge data-lang-es={tag} data-lang-en={tagsEn[tagIndex] ?? tag}>{tag}</Badge>
        ))}
      </div>
    )}

    <div class="border-t border-slate-800 pt-5">
      <button
        type="button"
        class="project-select-btn inline-flex items-center text-sm font-medium text-slate-200 transition-all duration-300 hover:translate-x-1 hover:text-white"
        data-project-select={id}
      >
        <span data-lang-es="Ver detalle" data-lang-en="View details">Ver detalle</span>
        <svg
          aria-hidden="true"
          class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </button>
    </div>
  </div>
</article>

<style>
  .project-card {
    animation: project-card-in 520ms ease both;
    animation-delay: var(--project-delay);
  }

  @keyframes project-card-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      animation: none;
    }
  }
</style>
