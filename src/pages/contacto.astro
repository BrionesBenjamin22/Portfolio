---
import "../styles/global.css";
import MainLayout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import InfoCard from "../components/ui/InfoCard.astro";
---

<MainLayout>
  <section class="space-y-10">
    <SectionHeader
      eyebrow="Contacto"
      title="Contacto y Redes"
      description="Podés contactarme por email, teléfono o a través de mis redes profesionales. Estoy abierto a oportunidades relacionadas con desarrollo backend, full stack, análisis y diseño de soluciones informáticas robustas."
      maxWidth="max-w-2xl"
    />

    <!-- CV destacado -->
    <InfoCard className="p-6 md:p-8 border-slate-700 bg-slate-900 shadow-[0_0_0_1px_rgba(148,163,184,0.08)]">
      <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
        <div class="max-w-3xl">
          <span class="inline-flex rounded-full border border-blue-500/30 bg-blue-500/10 px-3 py-1 text-xs font-medium text-blue-300">
            Documento disponible
          </span>

          <p class="mt-5 text-sm uppercase tracking-[0.2em] text-slate-500">
            Curriculum
          </p>

          <h2 class="mt-3 text-2xl md:text-3xl font-semibold text-slate-100">
            Descargar CV
          </h2>

          <p class="mt-4 text-slate-400 leading-7">
            Podés acceder a mi curriculum con información sobre formación,
            experiencia, tecnologías y perfil profesional.
          </p>
        </div>

        <div class="md:pt-10">
          <a
            href="/cv-benjamin-briones.pdf"
            target="_blank"
            class="inline-flex items-center rounded-xl border border-blue-500/30 bg-blue-500/10 px-4 py-2 text-sm font-medium text-blue-300 transition-colors hover:border-blue-400/40 hover:text-blue-200"
          >
            Descargar CV →
          </a>
        </div>
      </div>
    </InfoCard>

    <!-- Grid de contacto -->
    <div class="grid gap-4 md:grid-cols-2">
      <InfoCard className="p-6">
        <p class="text-sm uppercase tracking-[0.2em] text-slate-500">Email</p>
        <h2 class="mt-3 text-xl font-semibold text-slate-100">
          Correo de contacto
        </h2>
        <a
          href="mailto:benja.briones004@gmail.com"
          class="mt-4 inline-block text-slate-300 transition-colors hover:text-white"
        >
          benja.briones004@gmail.com
        </a>
      </InfoCard>

      <InfoCard className="p-6">
        <p class="text-sm uppercase tracking-[0.2em] text-slate-500">Teléfono</p>
        <h2 class="mt-3 text-xl font-semibold text-slate-100">
          Número de contacto
        </h2>
        <a
          href="tel:+5492216691441"
          class="mt-4 inline-block text-slate-300 transition-colors hover:text-white"
        >
          +54 9 221-669-1441
        </a>
      </InfoCard>

      <InfoCard className="p-6">
        <p class="text-sm uppercase tracking-[0.2em] text-slate-500">LinkedIn</p>
        <h2 class="mt-3 text-xl font-semibold text-slate-100">
          Perfil profesional
        </h2>
        <a
          href="https://www.linkedin.com/in/benjam%C3%ADn-briones-784375326/"
          target="_blank"
          rel="noreferrer"
          class="mt-4 inline-block text-slate-300 transition-colors hover:text-white"
        >
          linkedin.com/in/Benjamin-Briones
        </a>
      </InfoCard>

      <InfoCard className="p-6">
        <p class="text-sm uppercase tracking-[0.2em] text-slate-500">GitHub</p>
        <h2 class="mt-3 text-xl font-semibold text-slate-100">
          Repositorios y código
        </h2>
        <a
          href="https://github.com/BrionesBenjamin22"
          target="_blank"
          rel="noreferrer"
          class="mt-4 inline-block text-slate-300 transition-colors hover:text-white"
        >
          github.com/BrionesBenjamin22
        </a>
      </InfoCard>

      <InfoCard className="p-6">
        <p class="text-sm uppercase tracking-[0.2em] text-slate-500">Instagram</p>
        <h2 class="mt-3 text-xl font-semibold text-slate-100">
          Red personal
        </h2>
        <a
          href="https://instagram.com/benja_brionessss"
          target="_blank"
          rel="noreferrer"
          class="mt-4 inline-block text-slate-300 transition-colors hover:text-white"
        >
          instagram.com/benja_brionessss
        </a>
      </InfoCard>

      <InfoCard className="p-6">
        <p class="text-sm uppercase tracking-[0.2em] text-slate-500">Ubicación</p>
        <h2 class="mt-3 text-xl font-semibold text-slate-100">
          Base de trabajo
        </h2>
        <p class="mt-4 text-slate-300">
          La Plata, Buenos Aires, Argentina
        </p>
      </InfoCard>
    </div>

    <!-- Formación académica -->
    <InfoCard className="p-6 md:p-8">
      <p class="text-sm uppercase tracking-[0.2em] text-slate-500">
        Formación académica
      </p>

      <h2 class="mt-3 text-2xl font-semibold text-slate-100">
        Ingeniería en Sistemas
      </h2>

      <p class="mt-4 max-w-3xl text-slate-400 leading-7">
        Actualmente me encuentro cursando el cuarto año de la carrera de
        Ingeniería en Sistemas. En el corto plazo obtendré el título de
        Analista Universitario de Sistemas, continuando luego con la
        finalización de la ingeniería completa.
      </p>
    </InfoCard>

    <!-- Disponibilidad -->
    <InfoCard className="p-6 md:p-8">
      <p class="text-sm uppercase tracking-[0.2em] text-slate-500">
        Disponibilidad
      </p>

      <h2 class="mt-3 text-2xl font-semibold text-slate-100">
        Abierto a oportunidades y colaboraciones
      </h2>

      <p class="mt-4 max-w-3xl text-slate-400 leading-7">
        Actualmente me interesa seguir creciendo en desarrollo backend y full stack,
        participando en proyectos donde pueda aportar en APIs, lógica de negocio,
        sistemas de gestión y construcción de productos reales.
      </p>
    </InfoCard>
  </section>
</MainLayout>