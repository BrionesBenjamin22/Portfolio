---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Sobre mí | Benjamín Briones"
  description="Información personal y profesional de Benjamín Briones."
>
  <section class="max-w-3xl">
    <p class="mb-6 text-sm uppercase tracking-[0.24em] text-subtle" data-lang-es="Sobre mí" data-lang-en="About">
      Sobre mí
    </p>

    <h1 class="text-4xl font-semibold tracking-tight md:text-6xl" data-lang-es="Perfil en construcción, con foco técnico." data-lang-en="A profile in progress, with a technical focus.">
      Perfil en construcción, con foco técnico.
    </h1>

    <div class="mt-8 space-y-5 text-lg leading-8 text-muted">
      <p
        data-lang-es="Soy estudiante avanzado de Ingeniería en Sistemas de Información en la UTN-FRLP y desarrollo software desde proyectos académicos, personales y colaborativos."
        data-lang-en="I am an advanced Information Systems Engineering student at UTN-FRLP, building software through academic, personal and collaborative projects."
      >
        Soy estudiante avanzado de Ingeniería en Sistemas de Información en la UTN-FRLP y desarrollo software desde proyectos académicos, personales y colaborativos.
      </p>

      <p
        data-lang-es="Me interesa construir sistemas mantenibles, entender las decisiones de arquitectura detrás de cada solución y profundizar en backend, DevOps, observabilidad y operación en cloud."
        data-lang-en="I am interested in building maintainable systems, understanding the architectural decisions behind each solution and deepening my work in backend, DevOps, observability and cloud operations."
      >
        Me interesa construir sistemas mantenibles, entender las decisiones de arquitectura detrás de cada solución y profundizar en backend, DevOps, observabilidad y operación en cloud.
      </p>

      <p
        data-lang-es="Actualmente estoy preparando la certificación AWS CloudOps Engineer - Associate, como parte de una etapa de formación orientada a despliegue, operación y mantenimiento de entornos cloud."
        data-lang-en="I am currently preparing for the AWS CloudOps Engineer - Associate certification as part of a training stage focused on deployment, operation and maintenance of cloud environments."
      >
        Actualmente estoy preparando la certificación AWS CloudOps Engineer - Associate, como parte de una etapa de formación orientada a despliegue, operación y mantenimiento de entornos cloud.
      </p>
    </div>
  </section>

  <section class="mt-16 border-t border-line pt-10">
    <h2 class="text-2xl font-semibold tracking-tight" data-lang-es="Contacto" data-lang-en="Contact">
      Contacto
    </h2>

    <p
      class="mt-3 max-w-2xl leading-7 text-muted"
      data-lang-es="Abierto a ser contactado con fines profesionales."
      data-lang-en="Open to being contacted for professional purposes."
    >
      Abierto a ser contactado con fines profesionales.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <a
        class="focus-ring group rounded-2xl border border-line p-5 transition-colors hover:border-[var(--accent)]"
        href="mailto:benja.briones004@gmail.com"
      >
        <svg aria-hidden="true" class="h-5 w-5 text-muted transition-colors group-hover:text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
        <span class="mt-4 block font-medium">Mail</span>
        <span class="mt-1 block truncate text-sm text-muted">benja.briones004@gmail.com</span>
      </a>

      <a
        class="focus-ring group rounded-2xl border border-line p-5 transition-colors hover:border-[var(--accent)]"
        href="https://www.linkedin.com/in/benjam%C3%ADn-briones-784375326/"
        target="_blank"
        rel="noreferrer"
      >
        <svg aria-hidden="true" class="h-5 w-5 text-muted transition-colors group-hover:text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V9h4v2a6 6 0 0 1 5-3Z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg>
        <span class="mt-4 block font-medium">LinkedIn</span>
        <span class="mt-1 block truncate text-sm text-muted">linkedin.com/in/benjamín-briones</span>
      </a>

      <a
        class="focus-ring group rounded-2xl border border-line p-5 transition-colors hover:border-[var(--accent)]"
        href="https://github.com/BrionesBenjamin22"
        target="_blank"
        rel="noreferrer"
      >
        <svg aria-hidden="true" class="h-5 w-5 text-muted transition-colors group-hover:text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
        <span class="mt-4 block font-medium">GitHub</span>
        <span class="mt-1 block truncate text-sm text-muted">github.com/BrionesBenjamin22</span>
      </a>
    </div>
  </section>
</MainLayout>
